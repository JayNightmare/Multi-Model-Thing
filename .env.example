# Gateway (Fastify)
PORT=8000
HOST=0.0.0.0
DUCKDB_PATH=./data/traces.duckdb
FUZZER_URL=http://localhost:8001
# Comma-separated origins, or * for any. Defaults to localhost origins.
CORS_ORIGIN=
LOG_LEVEL=info

# Semantic fuzzer (FastAPI). Without weights it runs in mock mode.
FUZZER_MODEL_PATH=./models/model.gguf

# Production (docker-compose.prod.yml + Caddy). Studio is on GitHub Pages; set VITE_GATEWAY_URL as a repo variable.
# GATEWAY_DOMAIN=gateway.nexusgit.info
# CORS_ORIGIN=https://studio.nexusgit.info
# Auth is off when AUTH_PASSWORD is unset (dev). In production both are required.
# AUTH_PASSWORD=change-me
# JWT_SECRET=      # openssl rand -hex 32
# JWT_TTL_SECONDS=3600
# TRUST_PROXY=true # set when behind Caddy so rate limiting sees real client IPs
# VITE_GATEWAY_URL=https://gateway.nexusgit.info

# Studio (Vite). Leave unset in dev: the Vite server proxies /health and /v1 to GATEWAY_PROXY_URL (default http://localhost:8000).
# VITE_GATEWAY_URL=http://localhost:8000
