{
	"name": "@multi-model-thing/gateway",
	"version": "0.1.0",
	"private": true,
	"description": "Adversarial contract tester gateway: Zod contract interception, WebSocket telemetry, DuckDB trace storage",
	"type": "module",
	"main": "dist/server.js",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server.js",
		"migrate": "tsx src/storage/migrate.ts up",
		"migrate:rollback": "tsx src/storage/migrate.ts down",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@duckdb/node-api": "1.4.5-r.1",
		"@fastify/cors": "^11.3.1",
		"@fastify/websocket": "^11.3.4",
		"ajv": "^8.20.0",
		"fastify": "^5.12.7",
		"jose": "^6.2.13",
		"ws": "^8.22.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/ws": "^8.18.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
