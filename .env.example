# Gateway (Fastify)
PORT=8000
HOST=0.0.0.0
DUCKDB_PATH=./data/traces.duckdb
FUZZER_URL=http://localhost:8001
# Comma-separated origins, or * for any. Defaults to localhost origins.
CORS_ORIGIN=
LOG_LEVEL=info

# Semantic fuzzer (FastAPI). Without weights it runs in mock mode.
FUZZER_MODEL_PATH=./models/model.gguf

# Production (pm2 via ecosystem.config.cjs, or docker-compose.prod.yml + Caddy). Studio is on GitHub Pages; set VITE_GATEWAY_URL as a repo variable.
# GATEWAY_DOMAIN=gateway.nexusgit.info
# CORS_ORIGIN=https://studio.nexusgit.info
# Auth is off in dev. Enable GitHub sign-in (recommended) and/or a shared password for scripts. JWT_SECRET is required when either is set.
# JWT_SECRET=      # openssl rand -hex 32
# JWT_TTL_SECONDS=3600
# LEGAL_VERSION=1   # bump when the Terms or Privacy Policy change
# MCP_TOKEN_TTL_DAYS=30   # lifetime of tokens issued to MCP clients (users can revoke them on the Account page)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ALLOWED_USERS=*   # any GitHub account may sign in; or a comma-separated list of logins to restrict access (required, never empty)
# PUBLIC_URL=https://gateway.nexusgit.info          # callback: PUBLIC_URL/v1/auth/github/callback
# STUDIO_URL=https://studio.nexusgit.info           # where the browser returns after sign-in
# AUTH_PASSWORD=change-me                           # optional, for scripts that post traces
# TRUST_PROXY=true # set when behind Caddy so rate limiting sees real client IPs
# VITE_GATEWAY_URL=https://gateway.nexusgit.info

# Studio (Vite). Leave unset in dev: the Vite server proxies /health and /v1 to GATEWAY_PROXY_URL (default http://localhost:8000).
# VITE_GATEWAY_URL=http://localhost:8000
